# Copy to .env (never commit .env). Docker Compose reads it automatically.
APP_ENV=development                 # set to "production" to refuse a weak JWT_SECRET
JWT_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-me
CORS_ORIGINS=http://localhost:3000  # comma-separated browser origins allowed to call the API
NEXT_PUBLIC_API_URL=http://localhost:8000   # public API URL baked into the frontend at build time

# Demo data: seeds synthetic users/candidates on an empty database. Use SEED_DEMO=0 in production,
# then create real users with: python -m app.manage create-user EMAIL ROLE ORG
SEED_DEMO=1
NEXT_PUBLIC_DEMO_LOGINS=1          # show one-click demo sign-in buttons on the login page (build-time); 0 to hide
DEMO_PASSWORD=DemoPass123!

# JD extraction (any OpenAI-compatible chat-completions API). Leave empty to disable; manual scorecards still work.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
# Free option (Groq): LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions  and a model name from console.groq.com (e.g. llama-3.3-70b-versatile)

# Uploads
UPLOAD_MAX_MB=10
PROCESS_WORKERS=4                   # concurrent CV-processing threads
# Local (non-Docker) runs only. DATABASE_URL defaults to sqlite:///./talentra.db; UPLOAD_DIR to ./uploads
# DATABASE_URL=postgresql+psycopg://talentra:talentra@localhost:5432/talentra
# UPLOAD_DIR=./uploads

# Windows only, if Tesseract is installed outside the default folder and not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
